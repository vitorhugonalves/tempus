# App
APP_ENV=development
SECRET_KEY=gere-com-openssl-rand-base64-32
SESSION_TTL_SECONDS=28800

# Banco de dados
DATABASE_URL=sqlite+aiosqlite:///./tempus.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tempus

# Redis (estado quente dos timers e pub/sub)
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:senha@redis:6379/0
REDIS_TIMER_TTL_SECONDS=86400

# E-mail (para convite de competidores e recuperação de senha)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend (URL usada para gerar links em emails e CORS em desenvolvimento)
FRONTEND_URL=http://localhost:5173

# Admin padrão (criado automaticamente no primeiro alembic upgrade head)
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrador
