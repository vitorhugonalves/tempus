# App
APP_ENV=development          # development | production
SECRET_KEY=troque-isso-por-um-valor-seguro
SESSION_TTL_SECONDS=28800    # 8 horas

# Banco de dados
DATABASE_URL=sqlite+aiosqlite:///./tempus.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tempus

# E-mail (para convite de competidores e recuperação de senha)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Admin padrão (criado automaticamente no primeiro alembic upgrade head)
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrador
