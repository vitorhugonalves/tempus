FROM python:3.12-slim

WORKDIR /app

# Instalar dependências do sistema (WeasyPrint precisa de libs nativas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libharfbuzz0b libpangoft2-1.0-0 libharfbuzz-subset0 curl telnet \
    && rm -rf /var/lib/apt/lists/*

# Copiar código-fonte e instalar pacote (editable para que alembic e app usem o mesmo source)
COPY . .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e ".[dev]"

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
