# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_DB=tempus
POSTGRES_USER=tempus
POSTGRES_PASSWORD=tempus_dev_password

# ─────────────────────────────────────────────
# Backend (FastAPI)
# ─────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=troque-isso-por-um-segredo-longo-e-aleatorio

# DATABASE_URL é injetado automaticamente pelo docker-compose.dev.yml
# DATABASE_URL=postgresql+asyncpg://tempus:tempus_dev_password@postgres:5432/tempus

# REDIS_URL é injetado automaticamente pelo docker-compose.dev.yml
# REDIS_URL=redis://redis:6379/0

SESSION_TTL_SECONDS=28800

# Usuário admin criado pelo seed na primeira migration
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrador

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Email (opcional em dev — deixe vazio para desabilitar)
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─────────────────────────────────────────────
# Frontend (Vite)
# BACKEND_URL e PORT são injetados pelo docker-compose.dev.yml
# ─────────────────────────────────────────────
