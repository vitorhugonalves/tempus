# Variáveis do Docker Compose — PostgreSQL
# Copie este arquivo para docker/.env e ajuste os valores antes de subir os containers.
# NUNCA commite o arquivo docker/.env.

# Nome do banco de dados (padrão: tempus)
POSTGRES_DB=tempus

# Usuário do banco de dados (padrão: tempus)
POSTGRES_USER=tempus

# Senha do banco de dados — OBRIGATÓRIA, defina um valor forte em produção
# Gere uma senha segura com: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque-isso
